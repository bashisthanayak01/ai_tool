FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Port 7860 for HF Spaces health check (keeps space awake)
EXPOSE 7860

# Scheduler reads MONGO_URI from HF Space secrets
ENV MONGO_URI=""

# Run the HF scheduler (NOT the dashboard)
CMD ["python", "hf_scheduler.py"]
